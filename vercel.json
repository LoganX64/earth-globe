{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/embed(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/embed.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
